import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import os

from sklearn.linear_model import LinearRegression
from sklearn.ensemble import RandomForestRegressor
from sklearn.model_selection import TimeSeriesSplit
from sklearn.metrics import r2_score

# =========================
# SETTINGS
# =========================
SHOW_PHASE4_DIAGNOSTICS = True
SAVE_FIGS = True
OUTDIR = "figs"

RANDOM_STATE = 42
N_SPLITS = 5

# =========================
# PLOT STYLE
# =========================
plt.rcParams.update({
    "font.size": 14,          # default text size
    "axes.titlesize": 18,     # title size
    "axes.labelsize": 16,     # x/y label size
    "xtick.labelsize": 13,    # x tick size
    "ytick.labelsize": 13,    # y tick size
    "legend.fontsize": 13,    # legend size
})

# =========================
# LOAD
# =========================
df = pd.read_csv("full_analysis_data.csv")
df["date"] = pd.to_datetime(df["date"])
df = df.sort_values("date").reset_index(drop=True)

def assign_phase(d):
    if d < pd.Timestamp("2020-09-01"):
        return 1
    elif d < pd.Timestamp("2021-03-01"):
        return 2
    elif d < pd.Timestamp("2021-10-01"):
        return 3
    elif d < pd.Timestamp("2022-04-01"):
        return 4
    else:
        return 5

df["phase"] = df["date"].apply(assign_phase)

# =========================
# PART 1: LEVEL (log volume)
# =========================
df["y_level"] = np.log1p(df["tweet_volume"])
df["log_cases"]  = np.log1p(df["daily_new_cases"])
df["log_deaths"] = np.log1p(df["daily_new_deaths"])

# lags within phase to avoid leakage
df["y_lag1"]      = df.groupby("phase")["y_level"].shift(1)
df["cases_lag1"] = df.groupby("phase")["log_cases"].shift(1)
df["deaths_lag1"] = df.groupby("phase")["log_deaths"].shift(1)

X_level = ["log_cases", "log_deaths", "cases_lag1", "deaths_lag1", "y_lag1"]
y_level = "y_level"

level_rows = []
level_importance = {}

for p in sorted(df["phase"].unique()):
    d = df[df["phase"] == p].dropna(subset=X_level + [y_level]).reset_index(drop=True)
    n = len(d)

    if n < 60:
        print(f"[LEVEL skip] phase {p}: n={n}")
        continue

    X = d[X_level].values
    y = d[y_level].values

    tscv = TimeSeriesSplit(n_splits=min(N_SPLITS, max(2, n // 50)))

    r2_naive, r2_ols, r2_rf = [], [], []

    for tr, te in tscv.split(X):
        X_tr, X_te = X[tr], X[te]
        y_tr, y_te = y[tr], y[te]

        # Naive baseline: yhat = y_{t-1}
        yhat_naive = X_te[:, X_level.index("y_lag1")]
        r2_naive.append(r2_score(y_te, yhat_naive))

        # OLS
        ols = LinearRegression()
        ols.fit(X_tr, y_tr)
        r2_ols.append(r2_score(y_te, ols.predict(X_te)))

        # Random Forest
        rf = RandomForestRegressor(
            n_estimators=600,
            max_depth=6,
            min_samples_leaf=8,
            random_state=RANDOM_STATE,
            n_jobs=-1,
        )
        rf.fit(X_tr, y_tr)
        r2_rf.append(r2_score(y_te, rf.predict(X_te)))

    level_rows.append({
        "phase": p,
        "n": n,
        "Baseline_mean": np.mean(r2_naive),
        "Baseline_std": np.std(r2_naive),
        "OLS_mean": np.mean(r2_ols),
        "OLS_std": np.std(r2_ols),
        "RF_mean": np.mean(r2_rf),
        "RF_std": np.std(r2_rf),
    })

    # Fit RF on the full phase for feature importance
    rf_full = RandomForestRegressor(
        n_estimators=800,
        max_depth=6,
        min_samples_leaf=8,
        random_state=RANDOM_STATE,
        n_jobs=-1,
    )

    rf_full.fit(d[X_level].values, d[y_level].values)

    level_importance[p] = pd.Series(
        rf_full.feature_importances_,
        index=X_level
    ).sort_values(ascending=False)

level_res = pd.DataFrame(level_rows).sort_values("phase")

print("\nLEVEL results (log(tweet_volume)):")
print(level_res.to_string(index=False))

# =========================
# FIGURE 1: LEVEL PLOT
# =========================
plt.figure(figsize=(10, 5))

plt.errorbar(
    level_res["phase"],
    level_res["Baseline_mean"],
    yerr=level_res["Baseline_std"],
    marker="o",
    capsize=4,
    label="Baseline ($y_{t-1}$)"
)

plt.errorbar(
    level_res["phase"],
    level_res["OLS_mean"],
    yerr=level_res["OLS_std"],
    marker="o",
    capsize=4,
    label="OLS"
)

plt.errorbar(
    level_res["phase"],
    level_res["RF_mean"],
    yerr=level_res["RF_std"],
    marker="o",
    capsize=4,
    label="Random Forest"
)

plt.axhline(0, color="black", linewidth=0.8)

plt.xlabel("Phase", fontsize=16)
plt.ylabel("CV R² (out-of-sample, log(tweet_volume))", fontsize=16)
plt.title("LEVEL: Baseline vs OLS vs Random Forest", fontsize=18, fontweight="bold")

plt.xticks(fontsize=13)
plt.yticks(fontsize=13)
plt.legend(loc="lower right", fontsize=13)

plt.tight_layout()

if SAVE_FIGS:
    os.makedirs(OUTDIR, exist_ok=True)
    plt.savefig(f"{OUTDIR}/level_linearity.png", dpi=200, bbox_inches="tight")

plt.show()

# Print feature importance
for p, imp in level_importance.items():
    print(f"\n[LEVEL] Phase {p} RF feature importance:")
    print(imp)

# =========================
# PART 2: DIFFERENCED (Δlog volume)
# =========================
df["dy"] = df.groupby("phase")["y_level"].diff()
df["dcases"] = df.groupby("phase")["log_cases"].diff()
df["ddeaths"] = df.groupby("phase")["log_deaths"].diff()

X_diff = ["dcases", "ddeaths"]
y_diff = "dy"

diff_rows = []
diff_importance = {}

for p in sorted(df["phase"].unique()):
    d = df[df["phase"] == p].dropna(subset=X_diff + [y_diff]).reset_index(drop=True)
    n = len(d)

    if n < 60:
        print(f"[DIFF skip] phase {p}: n={n}")
        continue

    X = d[X_diff].values
    y = d[y_diff].values

    tscv = TimeSeriesSplit(n_splits=min(N_SPLITS, max(2, n // 50)))

    r2_base0, r2_ols, r2_rf = [], [], []

    for tr, te in tscv.split(X):
        X_tr, X_te = X[tr], X[te]
        y_tr, y_te = y[tr], y[te]

        # Baseline for differenced model: predict zero change
        yhat0 = np.zeros_like(y_te)
        r2_base0.append(r2_score(y_te, yhat0))

        # OLS
        ols = LinearRegression()
        ols.fit(X_tr, y_tr)
        r2_ols.append(r2_score(y_te, ols.predict(X_te)))

        # Random Forest
        rf = RandomForestRegressor(
            n_estimators=600,
            max_depth=6,
            min_samples_leaf=10,
            random_state=RANDOM_STATE,
            n_jobs=-1,
        )
        rf.fit(X_tr, y_tr)
        r2_rf.append(r2_score(y_te, rf.predict(X_te)))

    diff_rows.append({
        "phase": p,
        "n": n,
        "Base0_mean": np.mean(r2_base0),
        "Base0_std": np.std(r2_base0),
        "OLS_mean": np.mean(r2_ols),
        "OLS_std": np.std(r2_ols),
        "RF_mean": np.mean(r2_rf),
        "RF_std": np.std(r2_rf),
    })

    # Fit RF on the full phase for feature importance
    rf_full = RandomForestRegressor(
        n_estimators=800,
        max_depth=6,
        min_samples_leaf=10,
        random_state=RANDOM_STATE,
        n_jobs=-1,
    )

    rf_full.fit(d[X_diff].values, d[y_diff].values)

    diff_importance[p] = pd.Series(
        rf_full.feature_importances_,
        index=X_diff
    ).sort_values(ascending=False)

diff_res = pd.DataFrame(diff_rows).sort_values("phase")

print("\nDIFFERENCED results (Δlog(tweet_volume)):")
print(diff_res.to_string(index=False))

# =========================
# FIGURE 2: DIFFERENCED PLOT
# =========================
plt.figure(figsize=(10, 5))

plt.errorbar(
    diff_res["phase"],
    diff_res["Base0_mean"],
    yerr=diff_res["Base0_std"],
    marker="o",
    capsize=4,
    label="Baseline (Δ=0)"
)

plt.errorbar(
    diff_res["phase"],
    diff_res["OLS_mean"],
    yerr=diff_res["OLS_std"],
    marker="o",
    capsize=4,
    label="OLS"
)

plt.errorbar(
    diff_res["phase"],
    diff_res["RF_mean"],
    yerr=diff_res["RF_std"],
    marker="o",
    capsize=4,
    label="Random Forest"
)

plt.axhline(0, color="black", linewidth=0.8)

plt.xlabel("Phase", fontsize=16)
plt.ylabel("CV R² (out-of-sample, Δlog(tweet_volume))", fontsize=16)
plt.title("DIFFERENCED: Baseline vs OLS vs Random Forest", fontsize=18, fontweight="bold")

plt.xticks(fontsize=13)
plt.yticks(fontsize=13)
plt.legend(loc="lower right", fontsize=13)

plt.tight_layout()

if SAVE_FIGS:
    os.makedirs(OUTDIR, exist_ok=True)
    plt.savefig(f"{OUTDIR}/diff_robustness.png", dpi=200, bbox_inches="tight")

plt.show()

# Print feature importance
for p, imp in diff_importance.items():
    print(f"\n[DIFF] Phase {p} RF feature importance:")
    print(imp)
